# Copy to supabase/.env for `supabase functions serve --env-file supabase/.env`
# and set the same values with `supabase secrets set` for the hosted project.

OPENROUTER_API_KEY=sk-or-v1-...
SMALL_MODEL=anthropic/claude-haiku-5.5
STRONG_MODEL=anthropic/claude-sonnet-5.5
STRONG_FALLBACK_MODEL=anthropic/claude-haiku-5.5
# Optional comma-separated provider pins taken from /api/v1/endpoints/zdr
SMALL_PROVIDER_ORDER=
STRONG_PROVIDER_ORDER=

# Hard caps
STRONG_CALLS_PER_USER_PER_DAY=10
GLOBAL_DAILY_SPEND_USD=25
# Per-user daily model budget (USD). Past it the writer drops to SOUL_BUDGET_MODEL and nothing escalates.
USER_MODEL_BUDGET_USD_PER_DAY=0.15
# Writers (OpenRouter ids). SOUL_STRONG_REASONING: low (default) or medium.
SOUL_MODEL=anthropic/claude-sonnet-5.5
SOUL_LIGHT_MODEL=anthropic/claude-sonnet-5.5
SOUL_CHAT_MODEL=anthropic/claude-haiku-5.5
SOUL_BUDGET_MODEL=anthropic/claude-haiku-5.5
SOUL_STRONG_REASONING=low

# Shared secret the pg_cron job sends to evaluate-triggers
TRIGGER_SECRET=change-me

# APNs (.p8 key contents with literal \n for newlines)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=app.sobercoach.ios
APNS_SANDBOX=true

# Plain-text voice writer for emotional/reflective turns (Haiku is the cheap option)
VOICE_MODEL=anthropic/claude-sonnet-5.5

# Hosted project ref (used by the verify-sobercoach skill and make tone)
SUPABASE_PROJECT_REF=
